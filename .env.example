# Copie para .env no computador do robô e preencha. Nunca versione o .env.

# --- Autenticação (obrigatório) ---
TELEOP_USERNAME=operador
# Gere com: python -m teleop.hash_password   (coloque o valor entre aspas simples no shell)
TELEOP_PASSWORD_HASH=
# Alternativa menos segura (texto puro), usada somente se o hash estiver vazio:
# TELEOP_PASSWORD=
# Chave de assinatura dos logins (>= 32 caracteres). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
TELEOP_SECRET_KEY=
TELEOP_TOKEN_TTL_S=28800

# --- Servidor ---
TELEOP_HOST=0.0.0.0
TELEOP_PORT=8443
# HTTPS: necessário para o navegador do operador liberar o microfone (ver README)
TELEOP_SSL_CERTFILE=certs/robo.crt
TELEOP_SSL_KEYFILE=certs/robo.key
# Origens extras permitidas no WebSocket (separadas por vírgula). Normalmente vazio.
TELEOP_ALLOWED_ORIGINS=

# --- Vídeo (RF01) ---
# Índice da webcam (0, 1, ...) ou caminho do dispositivo (/dev/video0)
TELEOP_CAMERA=0
TELEOP_VIDEO_FPS=5
TELEOP_VIDEO_WIDTH=640
TELEOP_VIDEO_HEIGHT=480
# vp8 (padrão) ou h264
TELEOP_VIDEO_CODEC=vp8

# --- Áudio (RF02 / RF04) ---
# Vazio = dispositivo padrão do sistema. Liste com: python -m sounddevice
TELEOP_AUDIO_INPUT_DEVICE=
TELEOP_AUDIO_OUTPUT_DEVICE=
TELEOP_AUDIO_SAMPLE_RATE=48000

# --- Sessão ---
# Tempo (s) que a sessão aguarda o operador reconectar antes de liberar os dispositivos
TELEOP_SESSION_GRACE_S=20
